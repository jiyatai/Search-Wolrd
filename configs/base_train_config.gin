# Shared macros
NUM_SEMANTIC_CLASSES=6
ACTION_SIZE=8
# Path dim is 2 and path length is 5 (unused for UAV discrete actions).
FLAT_PATH_SIZE=10
NUM_EPOCHS=100
RECEPTIVE_FIELD=1
SEQUENCE_LENGTH=4
ENABLE_SEMANTIC=True
ENABLE_RGB_STYLEGAN=False
ENABLE_RGB_DIFFUSION=False
ENABLE_POLICY_DIFFUSION=False
IS_GWM_PRETRAIN=False
ENABLE_BEV_DECODER=False
ENABLE_BEV_ENCODER=False

# Train
train.epochs=%NUM_EPOCHS
train.precision="16-mixed"
train.data_module=@UAVDataModule
train.model_trainer=@SearchWorldTrainer
train.devices="auto"  # Set to number of GPUs or list like [0,1] or "auto"
train.ckpt_skip_n_epochs=30  # Don't save checkpoints before this epoch

#Trainer
SearchWorldTrainer.weight_decay=0.01
SearchWorldTrainer.lr=1e-5
SearchWorldTrainer.scheduler_pct_start=0.2

# Dataloader
UAVDataModule.batch_size=4
UAVDataModule.sequence_length=%SEQUENCE_LENGTH
UAVDataModule.num_workers=4
UAVDataModule.camera_view="front"
UAVDataModule.text_encoder_name="google/siglip2-base-patch16-224"
UAVDataModule.enable_depth=False

#Encoders
PoseEncoder.out_channels=32
PoseEncoder.pose_normalisation=50.0
ImageSigLIPEncoder.enable_fine_tune=False
ImageDINOEncoder.enable_fine_tune=False
UAVObservationEncoder.dino_encoder=@ImageDINOEncoder
UAVObservationEncoder.siglip_encoder=@ImageSigLIPEncoder
UAVObservationEncoder.pose_out_channels=32
UAVObservationEncoder.embedding_dim=1024
UAVObservationEncoder.enable_bev=%ENABLE_BEV_ENCODER
UAVObservationEncoder.bev_dim=1024

# Decoders
SegmentationHead.n_classes=%NUM_SEMANTIC_CLASSES
StyleGanDecoder.constant_size=(5, 8)

# MLPPolicy
MLPPolicy.command_n_channels=%ACTION_SIZE
MLPPolicy.path_n_channels=%FLAT_PATH_SIZE

# DiffusionPolicy
DiffusionPolicy.action_n_channels=%ACTION_SIZE
DiffusionPolicy.path_n_channels=%FLAT_PATH_SIZE
DiffusionPolicy.default_denoising_steps=50

# ConditionalUnet1D
ConditionalUnet1D.diffusion_step_embed_dim = 256
ConditionalUnet1D.unet_down_dims = [256, 512, 1024]
ConditionalUnet1D.kernel_size = 3

# ActionPolicy
ActionPolicy.policy_state_dim = 2048
ActionPolicy.text_feat_dim = 768
ActionPolicy.policy_state_fusion_mode="self_attn"
ActionPolicy.enable_policy_diffusion=%ENABLE_POLICY_DIFFUSION

# Losses
KLLoss.alpha=0.75
SegmentationLoss.use_top_k=False
SegmentationLoss.top_k_ratio=0.25
SegmentationLoss.use_poly_one=False
SegmentationLoss.poly_one_coefficient=0.0
SegmentationLoss.use_weights=True
SegmentationLoss.semantic_weights=[1.0, 2.0, 3.0, 5.0, 4.0, 2.5]
SearchWorldLoss.action_weight=10.0
SearchWorldLoss.path_weight = 5.0
# NOTE (beta_KL): this is the value reported in the paper appendix (tab:specs). The
# stage-1 / stage-2 configs intentionally override it to 3e-3 to stay in the regime the
# released checkpoints were trained in -- see configs/gwm_pretrain_parquet_config.gin.
SearchWorldLoss.kl_weight=0.001  # paper Appendix beta_KL
SearchWorldLoss.semantic_weight=2.0
SearchWorldLoss.rgb_weight=5.0
SearchWorldLoss.enable_semantic=%ENABLE_SEMANTIC
SearchWorldLoss.enable_rgb_stylegan=%ENABLE_RGB_STYLEGAN
SearchWorldLoss.enable_rgb_diffusion=%ENABLE_RGB_DIFFUSION
SearchWorldLoss.enable_policy_diffusion=%ENABLE_POLICY_DIFFUSION
SearchWorldLoss.is_gwm_pretrain=%IS_GWM_PRETRAIN
SearchWorldLoss.diffusion_weight=10.0
SearchWorldLoss.depth_weight=10.0

# RSSM
RSSM.action_dim=%ACTION_SIZE
RSSM.hidden_state_dim=1024
RSSM.state_dim=512
RSSM.action_latent_dim=64
RSSM.receptive_field=%RECEPTIVE_FIELD
RSSM.use_dropout=False
RSSM.dropout_probability=0.0

# SearchWorld
SearchWorld.enable_semantic=%ENABLE_SEMANTIC
SearchWorld.enable_rgb_stylegan=%ENABLE_RGB_STYLEGAN
SearchWorld.enable_rgb_diffusion=%ENABLE_RGB_DIFFUSION
SearchWorld.is_gwm_pretrain=%IS_GWM_PRETRAIN
SearchWorld.enable_bev_decoder=%ENABLE_BEV_DECODER

# SearchWorldLoss - complete params
SearchWorldLoss.enable_bev_decoder=%ENABLE_BEV_DECODER
SearchWorldLoss.diffusion_weight=10.0
SearchWorldLoss.bev_weight=1.0
SearchWorldLoss.bev_exploration_weight=1.0
SearchWorldLoss.bev_obstacle_weight=1.0
SearchWorldLoss.bev_value_weight=1.0
