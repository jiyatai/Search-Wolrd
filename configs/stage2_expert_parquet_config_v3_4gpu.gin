# Stage-2 Training Config - Expert Data (UAV Parquet)
# Loads stage-1 GWM-pretrained weights via `train.py -p <ckpt>`
# Semantic segmentation decoder is DISABLED (per project decision).

include 'configs/base_train_config.gin'

# ==================== Core Settings ====================
# Stage-2: full model with ActionPolicy, no semantic decoder
IS_GWM_PRETRAIN=False
ENABLE_SEMANTIC=False
ENABLE_RGB_STYLEGAN=True    # Keep RGB StyleGAN decoder (same as stage-1 ckpt)
ENABLE_RGB_DIFFUSION=False
ENABLE_POLICY_DIFFUSION=False
ENABLE_BEV_DECODER=True     # Keep BEV decoder (same as stage-1 ckpt)
ENABLE_BEV_ENCODER=True     # Keep BEV encoder (same as stage-1 ckpt)

# ==================== Dataset ====================
train.data_module=@UAVParquetDataModule
UAVParquetDataModule.enable_semantic=False
UAVParquetDataModule.enable_rgb_stylegan=True
UAVParquetDataModule.is_gwm_pretrain=False
UAVParquetDataModule.use_lazy_loading=True
UAVParquetDataModule.enable_bev=True

# ==================== Training ====================
NUM_EPOCHS=30
train.epochs=%NUM_EPOCHS
train.ckpt_skip_n_epochs=5
train.accumulate_grad_batches=3   # Save checkpoints early in stage-2
SearchWorldTrainer.lr=1e-5
SearchWorldTrainer.weight_decay=0.01

# DataLoader
UAVParquetDataModule.batch_size=4
UAVParquetDataModule.sequence_length=8
UAVParquetDataModule.num_workers=16

# ==================== Loss Weights ====================
# Enable policy learning (discrete action classification)
SearchWorldLoss.action_weight=10.0
SearchWorldLoss.path_weight=0.0
SearchWorldLoss.kl_weight=0.001       # paper Appendix beta_KL
SearchWorldLoss.rgb_weight=1.5        # Keep stage-1 value
# BEV v3: belief supervision + Dice + multi-scale. bev_weight 3.0 lifts the
# measured BEV gradient share (~0.2% at weight 1.0) to a level comparable to
# the KL / rgb_2 terms without fighting the action term.
SearchWorldLoss.bev_weight=3.0
SearchWorldLoss.bev_exploration_weight=1.0
SearchWorldLoss.bev_obstacle_weight=1.0
SearchWorldLoss.bev_value_weight=1.0
SearchWorldLoss.enable_bev_decoder=True
# --- BEVLoss: value-layer supervision (V* target, paper eq. valuetarget) ---
# V*(x) = Norm[(1 - M_obs*)(lambda_expl (1 - M_expl*) + lambda_goal * G_g(x))]
# with G_g a Gaussian of width sigma_g centred on the training-only target
# position ('target_rel'). Requires regenerated parquet with that column.
BEVLoss.lambda_expl=1.0
BEVLoss.lambda_goal=1.0
BEVLoss.sigma_g=10.0
BEVLoss.value_huber_beta=0.1
# Dice mixed into the sparse binary channels (positive rate ~1.3% / 0.3%).
BEVLoss.use_dice=True
BEVLoss.dice_weight=1.0
# Skip frames whose GT is entirely zero for a binary channel.
BEVLoss.skip_all_zero_frames=True
